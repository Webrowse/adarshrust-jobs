# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma

# OpenNext
.open-next

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
.env.local
.aider*

# research and planning docs (root only, named with underscores)
/[A-Z]*_*.md
/[A-Z]*_*.json
/posthog-setup-report.md

# same docs, parked out of the repo root. The rules above are root-anchored, so
# moving a file into a subdirectory would otherwise make it visible to Git again.
/ignored-MDs/

# generated cache
/data/oss-deps-cache.json

# NOTE: the scanner-generated dataset (content/{jobs,oss,grants,pulse,events,
# companies,portals,news}.json) is now a TRACKED published snapshot. PostgreSQL
# is the source of truth; the Refresh pipeline exports the canonical snapshot
# and commits it to Git, and the build consumes it. See lib/pipeline/snapshot.ts.

# search index - regenerated at build by scripts/build-search-index.mjs
/public/search-index.json

# the /oss browser's dataset - regenerated at build by scripts/build-oss-index.mjs.
# Served as a static, edge-cacheable asset so the page stops embedding ~5,400
# repos in its own HTML.
/public/oss-index.json

# slim public projection of content/oss.json - regenerated at build by
# scripts/build-oss-list.mjs. Public routes read this, never the full corpus.
/content/oss-list.json
/content/oss-qualified-crates.json

# co-occurrence index over content/oss.json - regenerated at build by
# scripts/build-companion-index.mjs. Was tracked until 2026-08-10, which let it
# freeze at a 2,100-repo snapshot while the corpus grew to 5,394: it gates which
# crates get a /deps page, so 538 qualifying crates were 404ing. Derived data
# belongs with the other build outputs, not in Git.
/content/oss-companion-index.json
design-reference/ghibli/
